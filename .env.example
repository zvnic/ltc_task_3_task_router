COMPOSE_PROJECT_NAME=beeline-routes
WEB_PORT=18032
POSTGRES_DB=beeline_routes
POSTGRES_USER=beeline_routes
POSTGRES_PASSWORD=__GENERATE_ON_INIT__
DATABASE_URL=postgresql+asyncpg://beeline_routes:__GENERATE_ON_INIT__@postgres:5432/beeline_routes
TEST_DATABASE_URL=postgresql+asyncpg://beeline_routes:__GENERATE_ON_INIT__@postgres:5432/beeline_routes_test
APP_ENV=production
LOG_LEVEL=INFO
PLANNING_TIMEOUT_SECONDS=45
SOLVER_TIME_LIMIT_SECONDS=10
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VALHALLA_URL=https://valhalla1.openstreetmap.de
VALHALLA_CLIENT_ID=task-router-local-demo
VALHALLA_MIN_INTERVAL_SECONDS=1.05
OSRM_FALLBACK_URL=https://routing.openstreetmap.de
OTP_URL=
ROUTING_TIMEOUT_SECONDS=20
ROUTING_ROUTE_TIMEOUT_SECONDS=45
ROUTING_RETRY_ATTEMPTS=2
ROUTING_RETRY_BACKOFF_SECONDS=1
GEOCODER_URL=https://nominatim.openstreetmap.org
# Public by default. Set true + APP_PASSWORD to require login.
AUTH_ENABLED=false
APP_PASSWORD=__SET_ME__
AUTH_SECRET=__GENERATE_ON_INIT__
